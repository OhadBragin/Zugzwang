<?xml version="1.0" encoding="utf-8"?>
<!-- Dark theme: "Nord", from the Nord palette (nordtheme.com). Same names as values/colors.xml. -->
<resources>
    <!-- Surfaces and text: Polar Night and Snow Storm -->
    <color name="bg">#2E3440</color>
    <color name="surface">#3B4252</color>
    <color name="outline">#4C566A</color>
    <color name="text">#ECEFF4</color>
    <color name="text_soft">#D8DEE9</color>

    <!-- Brand: Frost -->
    <color name="primary">#5E81AC</color>
    <color name="on_primary">#ECEFF4</color>
    <color name="primary_soft">#C9D6E8</color>
    <color name="primary_container">#434C5E</color>
    <!-- Frost #81A1C1, not #88C0D0, so titles and buttons don't look like the win color -->
    <color name="accent">#81A1C1</color>
    <color name="gold">#EBCB8B</color>

    <!-- Small circles behind pieces and the player avatar -->
    <color name="chip_soft">#4C566A</color>
    <color name="avatar">#81A1C1</color>
    <color name="on_avatar">#2E3440</color>

    <!-- Game results, "ice and ember": Frost cyan wins, Aurora orange losses, grey draws -->
    <color name="result_win">#88C0D0</color>
    <color name="result_loss">#D08770</color>
    <color name="result_draw">#A3ABBA</color>
    <color name="on_result_win">#2E3440</color>
    <color name="on_result_loss">#2E3440</color>
    <color name="on_result_draw">#2E3440</color>

    <!-- Board -->
    <color name="board_light">#D8DEE9</color>
    <color name="board_dark">#81A1C1</color>
    <color name="board_frame">#4C566A</color>
</resources>
