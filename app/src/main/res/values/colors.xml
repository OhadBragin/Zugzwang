<?xml version="1.0" encoding="utf-8"?>
<!--
    Light theme: "Nord Snow Storm".
    Built from the Nord palette (nordtheme.com). The dark theme lives in values-night/colors.xml
    and uses the same color names, so layouts never need to know which theme is active.
    Aurora colors are darkened here so they stay readable on light backgrounds.
-->
<resources>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Surfaces and text -->
    <color name="bg">#ECEFF4</color>
    <color name="surface">#FFFFFF</color>
    <color name="outline">#D8DEE9</color>
    <color name="text">#2E3440</color>
    <color name="text_soft">#4C566A</color>

    <!-- Brand: Nord frost blue -->
    <color name="primary">#5E81AC</color>
    <color name="on_primary">#FFFFFF</color>
    <color name="primary_soft">#D6E2F0</color>
    <color name="primary_container">#D6E2F0</color>
    <color name="accent">#4C6A92</color>
    <color name="gold">#EBCB8B</color>

    <!-- Small circles behind pieces and the player avatar -->
    <color name="chip_soft">#D8DEE9</color>
    <color name="avatar">#5E81AC</color>
    <color name="on_avatar">#FFFFFF</color>

    <!-- Game results: aurora yellow, red and purple -->
    <color name="result_win">#A67C1E</color>
    <color name="result_loss">#A9505A</color>
    <color name="result_draw">#8C6A86</color>
    <color name="on_result_win">#FFFFFF</color>
    <color name="on_result_loss">#FFFFFF</color>
    <color name="on_result_draw">#FFFFFF</color>

    <!-- Board -->
    <color name="board_light">#E5E9F0</color>
    <color name="board_dark">#81A1C1</color>
    <color name="board_frame">#4C566A</color>
</resources>
